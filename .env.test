# Plaintext env for Vitest and local `NODE_ENV=test` runs.
# Keeps dotenvx from loading encrypted `.env.development` (see server/config.ts).

NODE_ENV=test
PORT=3000
HOST=127.0.0.1

APP_NAME=Dark Avian LABS
APP_ID=auth
BASE_PROTOCOL=https
BASE_DOMAIN=example.test
AUTH_SUBDOMAIN=auth
APP_LIST=armory,codex
CODEX_MODULE_APP_IDS=warframe,epic7

AUTH_API_RATE_LIMIT_WINDOW_MS=900000
AUTH_API_RATE_LIMIT_MAX=1200

SESSION_SECRET=test-session-secret-not-for-production-use-only
SESSION_COOKIE_NAME=darkavianlabs.auth.sid

TRUST_PROXY=false
SECURE_COOKIES=false

COOKIE_DOMAIN=.example.test
AUTH_COOKIE_DOMAIN=.example.test
AUTH_COOKIE_NAME=darkavianlabs.auth.sid
SHARED_THEME_COOKIE_DOMAIN=.example.test

# Client / Vite (Vitest uses mode `test` and reads this file via loadEnv)
VITE_BASE_PATH=/
VITE_DEV_API_TARGET=http://127.0.0.1:3000
VITE_APP_NAME=Dark Avian
VITE_APP_NAME_2=LABS
VITE_LEGAL_ENTITY_NAME=Dark Avian Labs
VITE_LEGAL_PAGE_URL=/legal
VITE_SEARCH_PLACEHOLDER=Search users...
VITE_ALLOWED_NEXT_ORIGINS=https://auth.example.test,https://armory.example.test,https://codex.example.test
VITE_AVAILABLE_APPS=armory,codex
VITE_AUTH_ADMIN_URL=https://auth.example.test/admin
VITE_SHARED_THEME_COOKIE_DOMAIN=.example.test
